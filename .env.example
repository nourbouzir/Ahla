# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# `.env` is gitignored; `.env.example` is committed so teammates know what's needed.
#
#   cp .env.example .env
#
# AHLA runs on Laravel 11. After copying, generate the app key with:
#   php artisan key:generate

APP_NAME=AHLA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database (MySQL 8) -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahla_db
DB_USERNAME=ahla
DB_PASSWORD=change-me

# --- Queue / scheduler ------------------------------------------------------
QUEUE_CONNECTION=database
SESSION_LIFETIME=30

# --- Payment gateway (provider not chosen yet — use the sandbox) ------------
PAYMENT_GATEWAY=fake
PAYMENT_API_KEY=your-sandbox-key-here
PAYMENT_WEBHOOK_SECRET=your-webhook-signing-secret-here

# --- Translation API (provider not chosen yet) ------------------------------
TRANSLATION_PROVIDER=null
TRANSLATION_API_KEY=your-api-key-here

# --- Email / SMS (dev: logged, never sent) ----------------------------------
MAIL_MAILER=log
SMS_DRIVER=log

# --- Video call for host verification --------------------------------------
VIDEO_CALL_BASE_URL=https://meet.jit.si

# --- Matching weights (see docs/architecture.md section 6) -------------------
MATCH_WEIGHT_LANGUAGE=0.4
MATCH_WEIGHT_INTERESTS=0.3
MATCH_WEIGHT_PROXIMITY=0.2
MATCH_WEIGHT_RATING=0.1
