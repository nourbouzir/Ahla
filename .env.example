# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# `.env` is gitignored; `.env.example` is committed so teammates know what's needed.
#
#   cp .env.example .env
#
# AHLA runs on Laravel 12. After copying, generate the app key with:
#   php artisan key:generate

APP_NAME=AHLA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Tunis
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database (MySQL 8) -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahla_db
DB_USERNAME=ahla
DB_PASSWORD=change-me

# --- Queue / scheduler ------------------------------------------------------
QUEUE_CONNECTION=sync
SESSION_LIFETIME=30

# --- External contracts ------------------------------------------------------
# Local/test environments use the configured fakes in config/ahla.php.
# Production must bind concrete implementations; provider selection is deferred
# in ADR 0004, so do not add provider credentials until ADR 0005 is approved.

# --- Email / SMS (dev: logged, never sent) ----------------------------------
MAIL_MAILER=log
SMS_DRIVER=log

# --- Video call for host verification --------------------------------------
VIDEO_CALL_BASE_URL=https://meet.jit.si

# --- Matching weights (see docs/architecture.md section 6) -------------------
MATCH_WEIGHT_LANGUAGE=0.4
MATCH_WEIGHT_INTERESTS=0.3
MATCH_WEIGHT_PROXIMITY=0.2
MATCH_WEIGHT_RATING=0.1

# Payment: v1 uses the sandbox gateway (docs/decisions/0005). Secret signs webhooks; empty disables them.
AHLA_PAYMENT_WEBHOOK_SECRET=

# Recommendation weights (see docs/architecture.md section 6)
MATCH_WEIGHT_LANGUAGE=0.4
MATCH_WEIGHT_INTERESTS=0.3
MATCH_WEIGHT_PROXIMITY=0.2
MATCH_WEIGHT_RATING=0.1

# Translation service (LibreTranslate-compatible, ADR 0006). Leave empty to show originals only.
AHLA_TRANSLATE_URL=
AHLA_TRANSLATE_API_KEY=

# Behind a reverse proxy set TRUSTED_PROXIES (comma-separated IPs or *). Production also needs APP_ENV=production, APP_DEBUG=false.
TRUSTED_PROXIES=

# Indicative platform revenue = net volume x rate (reporting only, ADR 0007). Demo logins on the login page: off in production.
AHLA_COMMISSION_RATE=0.10
# AHLA_SHOW_DEMO_LOGINS=true   (default: on everywhere except production)
